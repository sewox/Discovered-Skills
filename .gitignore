# ==========================================
# Discovered Skills - .gitignore
# ==========================================

# Operating System Files
# ----------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Editor & IDE Files
# ------------------
# Visual Studio Code / Cursor / Windsurf
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Environment & Sensitive Files
# -----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials.json
token.json

# Node.js & Web Tooling (for artifacts/demos)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
build/
.cache/

# Python & AI Tooling (for scripts & benchmarks)
# ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary, Logs & Scratch Artifacts
# -----------------------------------
*.log
*.tmp
*.temp
scratch/
tmp/
